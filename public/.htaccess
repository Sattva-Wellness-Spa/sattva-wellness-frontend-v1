# Sattva Wellness Spa: Apache settings for GoDaddy cPanel (Linux) hosting.
# This file lives in public/, so `npm run build` copies it into out/ automatically.
#
# A mistake in this file makes the whole site show "500 Internal Server Error".
# If that happens right after an upload, rename .htaccess to htaccess.off in
# File Manager: if the site comes back, the problem is in this file.

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddCharset utf-8 .css .js .txt .xml .svg .json
</IfModule>

# ---------------------------------------------------------------------------
# GO LIVE: send every visitor to https://www.sattvawellnessspa.com/
# Uncomment the block below only once https://www.sattvawellnessspa.com/ opens
# with a padlock. GoDaddy installs the free SSL certificate some time after the
# domain is connected; redirecting before then shows visitors a security warning.
# Only the real domain is redirected, so a temporary or preview address keeps working.
# ---------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^sattvawellnessspa\.com$ [NC]
#   RewriteRule ^ https://www.sattvawellnessspa.com%{REQUEST_URI} [L,R=301]
#   RewriteCond %{HTTP_HOST} ^www\.sattvawellnessspa\.com$ [NC]
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#   RewriteRule ^ https://www.sattvawellnessspa.com%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_headers.c>
  # Security headers.
  # The Content-Security-Policy only allows scripts, styles, fonts and images from
  # this site. If you add a third-party tool later (Google Analytics, a Maps embed,
  # Meta Pixel...), add its domains here or the browser will block it.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Tell browsers to always use HTTPS. Only sent on HTTPS requests, so it has no
  # effect until the SSL certificate is working.
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>

  # Caching.
  # Pages, robots.txt and sitemap.xml are revalidated on every visit so a new deploy shows up straight away.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Icons and the share image keep the same name between deploys: cache them for a day.
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Hashed build files never change (their names change instead): cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Compress text files on the way out (roughly 70% smaller).
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
  </IfModule>
</IfModule>
